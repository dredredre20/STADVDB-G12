<!DOCTYPE html>
<html>
<head>
    <title>Transaction Builder - Node 1</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
<h2>Distributed Transaction Builder — Node 1 Control Panel</h2>

<!-- Choose which node to run transactions on -->
<label>Target Node:</label>
<select id="nodeUrl">
    <option value="http://ccscloud.dlsu.edu.ph:60148">Node 1 (Central)</option>
    <option value="http://ccscloud.dlsu.edu.ph:60149">Node 2 (Comedy)</option>
    <option value="http://ccscloud.dlsu.edu.ph:60150">Node 3 (Drama)</option>
</select>

<br><br>

<!-- Isolation Level -->
<label>Isolation Level:</label>
<select id="isolationLevel">
    <option value="read_uncommitted">Read Uncommitted</option>
    <option value="read_committed">Read Committed</option>
    <option value="repeatable_read">Repeatable Read</option>
    <option value="serializable">Serializable</option>
</select>

<br><br>


<button onclick="applySettings()">Apply Settings</button>

<hr>

<label>Transaction ID:</label>
<input id="txId" placeholder="T1">

<label>Title ID:</label>
<input id="titleId" placeholder="tt0000001">

<label>New Rating:</label>
<input id="newRating" type="number" min="1" max="10" required>

<br><br>

<button onclick="beginTx()">Begin Transaction</button>
<button onclick="readTx()">READ</button>
<button onclick="updateTx()">UPDATE</button>
<button onclick="commitTx()">COMMIT</button>
<button onclick="abortTx()">ABORT</button>
<button onclick="recoverTx()">RECOVER</button>

<hr>

<button onclick="goMonitor()">Go To Monitor</button>

<pre id="output"></pre>

<script src="/app.js"></script>
</body>
</html>
